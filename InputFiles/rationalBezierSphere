inactiveTally {}

activeTally {
  display (k_eff);
  k_eff { type keffAnalogClerk; }
}

geometry {
    type geometryStd;
    boundary (1 1 1 1 1 1);
    graph { type shrunk; }

    surfaces {
      outerBox { id 1; type box; origin (0.0 0.0 0.0); halfwidth (2.0 2.0 2.0); }

      sphere_vol {
        type bezierVolume;
        id 2;
        numPatches 8;
        diagRadius 1.5;

        // Exact rational Bezier sphere, r=1.5, degree-elevated biquadratic.
        // Control points derived from biquadratic NURBS sphere (8-octant decomposition)
        // elevated to bicubic. Variables used below:
        //   a = r = 1.5
        //   b = r(2-sqrt(2)) = 0.87867966  (off-axis edge control point coordinate)
        //   c = 3(3-2*sqrt(2)) = 0.51471863 (asymmetric interior control point coordinate)
        ctrlPts (
          // ---- Patch 1: +x +y +z octant ----
          // j=1: north pole (all identical)
           0.0        0.0        1.5    0.0        0.0        1.5    0.0        0.0        1.5    0.0        0.0        1.5
          // j=2: near-pole ring
           0.87867966 0.0        1.5    0.87867966 0.51471863 1.5    0.51471863 0.87867966 1.5    0.0        0.87867966 1.5
          // j=3: near-equatorial ring
           1.5        0.0        0.87867966    1.5        0.87867966 0.87867966    0.87867966 1.5        0.87867966    0.0        1.5        0.87867966
          // j=4: equatorial arc
           1.5        0.0        0.0    1.5        0.87867966 0.0    0.87867966 1.5        0.0    0.0        1.5        0.0

          // ---- Patch 2: -x +y +z octant ----
           0.0        0.0        1.5    0.0        0.0        1.5    0.0        0.0        1.5    0.0        0.0        1.5
          -0.87867966 0.0        1.5   -0.87867966 0.51471863 1.5   -0.51471863 0.87867966 1.5    0.0        0.87867966 1.5
          -1.5        0.0        0.87867966   -1.5        0.87867966 0.87867966   -0.87867966 1.5        0.87867966    0.0        1.5        0.87867966
          -1.5        0.0        0.0   -1.5        0.87867966 0.0   -0.87867966 1.5        0.0    0.0        1.5        0.0

          // ---- Patch 3: -x -y +z octant ----
           0.0        0.0        1.5    0.0        0.0        1.5    0.0        0.0        1.5    0.0        0.0        1.5
          -0.87867966 0.0        1.5   -0.87867966 -0.51471863 1.5   -0.51471863 -0.87867966 1.5    0.0       -0.87867966 1.5
          -1.5        0.0        0.87867966   -1.5        -0.87867966 0.87867966   -0.87867966 -1.5        0.87867966    0.0       -1.5        0.87867966
          -1.5        0.0        0.0   -1.5        -0.87867966 0.0   -0.87867966 -1.5        0.0    0.0       -1.5        0.0

          // ---- Patch 4: +x -y +z octant ----
           0.0        0.0        1.5    0.0        0.0        1.5    0.0        0.0        1.5    0.0        0.0        1.5
           0.87867966 0.0        1.5    0.87867966 -0.51471863 1.5    0.51471863 -0.87867966 1.5    0.0       -0.87867966 1.5
           1.5        0.0        0.87867966    1.5        -0.87867966 0.87867966    0.87867966 -1.5        0.87867966    0.0       -1.5        0.87867966
           1.5        0.0        0.0    1.5        -0.87867966 0.0    0.87867966 -1.5        0.0    0.0       -1.5        0.0

          // ---- Patch 5: +x +y -z octant ----
           0.0        0.0       -1.5    0.0        0.0       -1.5    0.0        0.0       -1.5    0.0        0.0       -1.5
           0.87867966 0.0       -1.5    0.87867966 0.51471863 -1.5    0.51471863 0.87867966 -1.5    0.0        0.87867966 -1.5
           1.5        0.0       -0.87867966    1.5        0.87867966 -0.87867966    0.87867966 1.5       -0.87867966    0.0        1.5       -0.87867966
           1.5        0.0        0.0    1.5        0.87867966 0.0    0.87867966 1.5        0.0    0.0        1.5        0.0

          // ---- Patch 6: -x +y -z octant ----
           0.0        0.0       -1.5    0.0        0.0       -1.5    0.0        0.0       -1.5    0.0        0.0       -1.5
          -0.87867966 0.0       -1.5   -0.87867966 0.51471863 -1.5   -0.51471863 0.87867966 -1.5    0.0        0.87867966 -1.5
          -1.5        0.0       -0.87867966   -1.5        0.87867966 -0.87867966   -0.87867966 1.5       -0.87867966    0.0        1.5       -0.87867966
          -1.5        0.0        0.0   -1.5        0.87867966 0.0   -0.87867966 1.5        0.0    0.0        1.5        0.0

          // ---- Patch 7: -x -y -z octant ----
           0.0        0.0       -1.5    0.0        0.0       -1.5    0.0        0.0       -1.5    0.0        0.0       -1.5
          -0.87867966 0.0       -1.5   -0.87867966 -0.51471863 -1.5   -0.51471863 -0.87867966 -1.5    0.0       -0.87867966 -1.5
          -1.5        0.0       -0.87867966   -1.5        -0.87867966 -0.87867966   -0.87867966 -1.5       -0.87867966    0.0       -1.5       -0.87867966
          -1.5        0.0        0.0   -1.5        -0.87867966 0.0   -0.87867966 -1.5        0.0    0.0       -1.5        0.0

          // ---- Patch 8: +x -y -z octant ----
           0.0        0.0       -1.5    0.0        0.0       -1.5    0.0        0.0       -1.5    0.0        0.0       -1.5
           0.87867966 0.0       -1.5    0.87867966 -0.51471863 -1.5    0.51471863 -0.87867966 -1.5    0.0       -0.87867966 -1.5
           1.5        0.0       -0.87867966    1.5        -0.87867966 -0.87867966    0.87867966 -1.5       -0.87867966    0.0       -1.5       -0.87867966
           1.5        0.0        0.0    1.5        -0.87867966 0.0    0.87867966 -1.5        0.0    0.0       -1.5        0.0
        );

        // Rational Bezier weights for exact sphere representation.
        // Weight pattern per patch (all 8 patches identical):
        //   j=1 (pole):      1.0       W_mid     W_mid     1.0
        //   j=2 (near-pole): W_mid     W_mid^2   W_mid^2   W_mid
        //   j=3 (near-eq):   W_mid     W_mid^2   W_mid^2   W_mid
        //   j=4 (equator):   1.0       W_mid     W_mid     1.0
        // where W_mid = (1+sqrt(2))/3 = 0.80473785
        //       W_mid^2 = (3+2*sqrt(2))/9 = 0.64760301
        weights (
          // Patch 1
          1.0        0.80473785 0.80473785 1.0
          0.80473785 0.64760301 0.64760301 0.80473785
          0.80473785 0.64760301 0.64760301 0.80473785
          1.0        0.80473785 0.80473785 1.0
          // Patch 2
          1.0        0.80473785 0.80473785 1.0
          0.80473785 0.64760301 0.64760301 0.80473785
          0.80473785 0.64760301 0.64760301 0.80473785
          1.0        0.80473785 0.80473785 1.0
          // Patch 3
          1.0        0.80473785 0.80473785 1.0
          0.80473785 0.64760301 0.64760301 0.80473785
          0.80473785 0.64760301 0.64760301 0.80473785
          1.0        0.80473785 0.80473785 1.0
          // Patch 4
          1.0        0.80473785 0.80473785 1.0
          0.80473785 0.64760301 0.64760301 0.80473785
          0.80473785 0.64760301 0.64760301 0.80473785
          1.0        0.80473785 0.80473785 1.0
          // Patch 5
          1.0        0.80473785 0.80473785 1.0
          0.80473785 0.64760301 0.64760301 0.80473785
          0.80473785 0.64760301 0.64760301 0.80473785
          1.0        0.80473785 0.80473785 1.0
          // Patch 6
          1.0        0.80473785 0.80473785 1.0
          0.80473785 0.64760301 0.64760301 0.80473785
          0.80473785 0.64760301 0.64760301 0.80473785
          1.0        0.80473785 0.80473785 1.0
          // Patch 7
          1.0        0.80473785 0.80473785 1.0
          0.80473785 0.64760301 0.64760301 0.80473785
          0.80473785 0.64760301 0.64760301 0.80473785
          1.0        0.80473785 0.80473785 1.0
          // Patch 8
          1.0        0.80473785 0.80473785 1.0
          0.80473785 0.64760301 0.64760301 0.80473785
          0.80473785 0.64760301 0.64760301 0.80473785
          1.0        0.80473785 0.80473785 1.0
        );
      }
    }

    cells {
      inner { type simpleCell; id 10; surfaces (-2);    filltype mat; material fuel; }
      outer { type simpleCell; id 11; surfaces (2);     filltype mat; material water; }
    }

    universes {
      root { id 1; type rootUniverse; border 1; fill u<2>; }
      uni  { id 2; type cellUniverse; cells (10 11); }
    }
}

