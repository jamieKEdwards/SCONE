!! JEZEBEL benchmark (PU-MET-FAST-001 rev. 3) with Neural SDF surface
!! Reference: LA-UR-14-21554
!!
!! Bare Pu-239 sphere, physical radius 6.39157 cm
!! Reference k_eff = 1.0000 +/- 0.0020
!!
!! Neural surface: unit-sphere MLP weights scaled via geometricScale = 6.39157
!! Transport: delta tracking (neuralSurface returns INF for distance())
!!
!! Run: ./Build/scone.out InputFiles/neuralSphere_jezebel

type eigenPhysicsPackage;

pop      400000;
active   500;
inactive 20;
XSdata   ceData;
dataType ce;
outputFile neuralJezebel_v2;
outputFormat asciiJSON;

collisionOperator { neutronCE { type neutronCEstd; } }

transportOperator { type transportOperatorDT; }

inactiveTally {}

activeTally {
  display (k_eff);
  norm fiss;
  normVal 100.0;
  k_eff { type keffAnalogClerk; }
  fiss  { type collisionClerk; response (fiss); fiss { type macroResponse; MT -6; } }
  flux  { type collisionClerk;
          map { type energyMap; grid log; min 0.001; max 20; N 1000; }
          response (flux); flux { type fluxResponse; }
        }
}

geometry {
    type geometryStd;
    boundary (0 0 0 0 0 0);
    graph { type shrunk; }

    surfaces {
      !! Outer boundary: slightly larger than scaled training bbox (1.5 * 6.39157 = 9.587 cm)
      outerBox { id 1; type box; origin (0.0 0.0 0.0); halfwidth (10.0 10.0 10.0); }

      !! Neural SDF sphere: unit-sphere weights scaled to Jezebel radius
      jezebel_neural {
        id 2;
        type neuralSurface;
        weightFile /home/jamie/SCONE/weights/sphere_neural_200k_f32_v2.bin;
        geometricScale 6.39157;
        diagRadius 6.39157;
      }
    }

    cells {
      fuel_region  { type simpleCell; id 10; surfaces (-2);  filltype mat; material fuel; }
      outer_region { type simpleCell; id 11; surfaces (2);   filltype mat; material void; }
    }

    universes {
      root { id 1; type rootUniverse; border 1; fill u<2>; }
      uni  { id 2; type cellUniverse; cells (10 11); }
    }
}

nuclearData {
  handles {
    ceData { type aceNeutronDatabase; aceLibrary /home/jamie/nuclearData/XSdata_jeff311/jeff311.aceXS; }
  }

  materials {
    fuel {
      temp 273;
      composition {
        94239.03  0.037047;
        94240.03  0.0017512;
        94241.03  0.00011674;
        31069.03  0.00083603;
        31071.03  0.00053917;
      }
    }

  }
}
