type eigenPhysicsPackage;

pop      25000;
active   100;
inactive 50;
XSdata ce;
dataType ce;
outputFile bezier_lightbridge_main;

// Specify output format default asciiMATLAB
outputFormat asciiJSON;

collisionOperator { neutronCE {type neutronCEstd;}
//collisionOperator { neutronCE {type neutronCEstd; DBRCeMin 1.0e-8; DBRCeMax 2.0e-3;}
                    }

transportOperator { //type transportOperatorST;
                   type transportOperatorDT;
                   // type transportOperatorHT;
                   }

inactiveTally {}

activeTally  {
                display (k_eff);
                norm fiss;
                normVal 100.0;
                k_eff { type keffAnalogClerk;}

                fiss { type collisionClerk; response (fiss); fiss {type macroResponse; MT -6;}}

                fluxSpectrum {type collisionClerk;
                        map {
                             type energyMap; grid log; min 1.0E-11; max 20.0; N 1000;
                             }
                        response (flux);
                        flux { type fluxResponse;}
                        }

                fissMap {type collisionClerk;
                        map {type multiMap; maps (map1 map2);
                             map1 { type spaceMap; axis x; grid lin; min -4.5; max 4.5; N 1000; }
                             map2 { type spaceMap; axis y; grid lin; min -4.5; max 4.5; N 1000; }  }
                        response (fission);
                        fission { type macroResponse; MT -6;}   }

                fluxMap {type collisionClerk;
                        map {type multiMap; maps (map1 map2 map3);
                             map1 { type spaceMap; axis x; grid lin; min -4.5; max 4.5; N 1000; }
                             map2 { type spaceMap; axis y; grid lin; min -4.5; max 4.5; N 1000; }
                             map3 { type energyMap; grid unstruct; bins (1.0e-9 1.0e-3 20.0); }
                             }
                        response (f);
                        f { type fluxResponse;}   }

                U8absorption {type collisionClerk;
                        map { type energyMap; grid log; min 1.0E-11; max 20.0; N 1000; }
                        response (u8);
                        u8 { type microResponse; MT 102; material u8; }
                            }
                }



